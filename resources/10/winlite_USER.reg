Windows Registry Editor Version 5.00

; Windows Lite 10 Registry by Irochi (https://irochi.moe) for HKEY_CURRENT_USER

; 새 사용자 OneDrive 자동 설치 비활성화
[-HKEY_LOCAL_MACHINE\USER_winlite\Software\Microsoft\Windows\CurrentVersion\Run]

; 추천 앱 자동 설치 및 시작 메뉴·설정 광고 비활성화
[HKEY_LOCAL_MACHINE\USER_winlite\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager]
"OemPreInstalledAppsEnabled"=dword:00000000
"PreInstalledAppsEnabled"=dword:00000000
"PreInstalledAppsEverEnabled"=dword:00000000
"SilentInstalledAppsEnabled"=dword:00000000
"SystemPaneSuggestionsEnabled"=dword:00000000
"FeatureManagementEnabled"=dword:00000000
"SoftLandingEnabled"=dword:00000000
"SubscribedContentEnabled"=dword:00000000
"SubscribedContent-310093Enabled"=dword:00000000
"SubscribedContent-338388Enabled"=dword:00000000
"SubscribedContent-338389Enabled"=dword:00000000
"SubscribedContent-338393Enabled"=dword:00000000
"SubscribedContent-353694Enabled"=dword:00000000
"SubscribedContent-353696Enabled"=dword:00000000

; 클래식 Outlook에서 New Outlook 자동 전환 비활성화
[HKEY_LOCAL_MACHINE\USER_winlite\Software\Policies\Microsoft\office\16.0\outlook\preferences]
"NewOutlookMigrationUserSetting"=dword:00000000

; 작업 표시줄 작업 보기 버튼 숨기기
[HKEY_LOCAL_MACHINE\USER_winlite\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced]
"ShowTaskViewButton"=dword:00000000

; 작업 표시줄 검색 상자를 아이콘으로 표시
[HKEY_LOCAL_MACHINE\USER_winlite\Software\Microsoft\Windows\CurrentVersion\Search]
"SearchboxTaskbarMode"=dword:00000001

; 뉴스 및 관심사 비활성화 (권한 문제로 인해 19045.6396 부터 수정 불가)
; [HKEY_LOCAL_MACHINE\USER_winlite\Software\Microsoft\Windows\CurrentVersion\Feeds]
; "ShellFeedsTaskbarViewMode"=dword:00000002

; Win+X 메뉴에 PowerShell 대신 명령 프롬프트 표시
[HKEY_LOCAL_MACHINE\USER_winlite\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced]
"DontUsePowerShellOnWinX"=dword:00000001

; 시작 메뉴 Microsoft 계정 알림 비활성화
[HKEY_LOCAL_MACHINE\USER_winlite\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced]
"Start_AccountNotifications"=dword:00000000

; 탐색기 실행시 내 PC를 기본으로 표시
[HKEY_LOCAL_MACHINE\USER_winlite\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced]
"LaunchTo"=dword:00000001

; 파일 탐색기 동기화 공급자 알림 비활성화
[HKEY_LOCAL_MACHINE\USER_winlite\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced]
"ShowSyncProviderNotifications"=dword:00000000

; 바탕화면 Windows 추천(Spotlight) 배경 비활성화
[HKEY_LOCAL_MACHINE\USER_winlite\Software\Microsoft\Windows\CurrentVersion\DesktopSpotlight\Settings]
"EnabledState"=dword:00000000

; 바탕화면 Windows 추천(Spotlight) 배경 정책 비활성화 (Home, Pro 에디션 사용불가)
[HKEY_LOCAL_MACHINE\USER_winlite\Software\Policies\Microsoft\Windows\CloudContent]
"DisableSpotlightCollectionOnDesktop"=dword:00000001

; 바탕화면 '이 사진에 대해 알아보기' 아이콘 숨기기
[HKEY_LOCAL_MACHINE\USER_winlite\Software\Microsoft\Windows\CurrentVersion\Explorer\HideDesktopIcons\NewStartPanel]
"{2cc5ca98-6485-489a-920e-b3e88a6ccce3}"=dword:00000001

; Windows 검색에서 웹 및 Bing 결과 비활성화
[HKEY_LOCAL_MACHINE\USER_winlite\Software\Policies\Microsoft\Windows\Explorer]
"DisableSearchBoxSuggestions"=dword:00000001
[HKEY_LOCAL_MACHINE\USER_winlite\Software\Microsoft\Windows\CurrentVersion\Search]
"BingSearchEnabled"=dword:00000000

; 검색 하이라이트 비활성화 (사용자 설정)
[HKEY_LOCAL_MACHINE\USER_winlite\Software\Microsoft\Windows\CurrentVersion\SearchSettings]
"IsDynamicSearchBoxEnabled"=dword:00000000

; 잠금 화면 팁 및 재미있는 정보 비활성화
[HKEY_LOCAL_MACHINE\USER_winlite\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager]
"RotatingLockScreenOverlayEnabled"=dword:00000000
"SubscribedContent-338387Enabled"=dword:00000000

; Spotlight 타사 앱 추천 비활성화
[HKEY_LOCAL_MACHINE\USER_winlite\Software\Policies\Microsoft\Windows\CloudContent]
"DisableThirdPartySuggestions"=dword:00000001

; '장치 설정을 완료합니다' 팝업 비활성화
[HKEY_LOCAL_MACHINE\USER_winlite\Software\Microsoft\Windows\CurrentVersion\UserProfileEngagement]
"ScoobeSystemSettingEnabled"=dword:00000000

; 설치 후 첫 로그인 1시간 방해 금지 모드 비활성화
[HKEY_LOCAL_MACHINE\USER_winlite\Software\Microsoft\Windows\CurrentVersion\Notifications\QuietHours\PostOOBETimer]
"FirstRunTime"=hex:00,10,5e,5f,00,00,00,00

; 광고 ID, 맞춤형 환경, 입력·음성 데이터 수집 비활성화
[HKEY_LOCAL_MACHINE\USER_winlite\Software\Microsoft\Windows\CurrentVersion\Privacy]
"TailoredExperiencesWithDiagnosticDataEnabled"=dword:00000000
[HKEY_LOCAL_MACHINE\USER_winlite\Software\Microsoft\Windows\CurrentVersion\AdvertisingInfo]
"Enabled"=dword:00000000
[HKEY_LOCAL_MACHINE\USER_winlite\Software\Microsoft\Speech_OneCore\Settings\OnlineSpeechPrivacy]
"HasAccepted"=dword:00000000
[HKEY_LOCAL_MACHINE\USER_winlite\Software\Microsoft\Input\TIPC]
"Enabled"=dword:00000000
[HKEY_LOCAL_MACHINE\USER_winlite\Software\Microsoft\InputPersonalization]
"RestrictImplicitInkCollection"=dword:00000001
"RestrictImplicitTextCollection"=dword:00000001
[HKEY_LOCAL_MACHINE\USER_winlite\Software\Microsoft\InputPersonalization\TrainedDataStore]
"HarvestContacts"=dword:00000000
[HKEY_LOCAL_MACHINE\USER_winlite\Software\Microsoft\Personalization\Settings]
"AcceptedPrivacyPolicy"=dword:00000000

; 진단 데이터 기반 맞춤형 환경 정책 비활성화
[HKEY_LOCAL_MACHINE\USER_winlite\Software\Policies\Microsoft\Windows\CloudContent]
"DisableTailoredExperiencesWithDiagnosticData"=dword:00000001

; 피드백 요청 빈도 '안 함'
[HKEY_LOCAL_MACHINE\USER_winlite\Software\Microsoft\Siuf\Rules]
"NumberOfSIUFInPeriod"=dword:00000000
"PeriodInNanoSeconds"=dword:00000000

; 작업 표시줄 Copilot 버튼 및 자동 고정 비활성화
[HKEY_LOCAL_MACHINE\USER_winlite\Software\Policies\Microsoft\Windows\WindowsCopilot]
"TurnOffWindowsCopilot"=dword:00000001
[HKEY_LOCAL_MACHINE\USER_winlite\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced]
"ShowCopilotButton"=dword:00000000

; Xbox 게임 녹화(Game DVR) 비활성화
[HKEY_LOCAL_MACHINE\USER_winlite\Software\Microsoft\Windows\CurrentVersion\GameDVR]
"AppCaptureEnabled"=dword:00000000
[HKEY_LOCAL_MACHINE\USER_winlite\System\GameConfigStore]
"GameDVR_Enabled"=dword:00000000

; 종료 시 응답 없는 프로그램 자동 종료
[HKEY_LOCAL_MACHINE\USER_winlite\Control Panel\Desktop]
"AutoEndTasks"="1"

; 메뉴 표시 딜레이 비활성화
[HKEY_LOCAL_MACHINE\USER_winlite\Control Panel\Desktop]
"MenuShowDelay"="0"

; 시작 프로그램 실행 딜레이 비활성화
[HKEY_LOCAL_MACHINE\USER_winlite\Software\Microsoft\Windows\CurrentVersion\Explorer\Serialize]
"StartupDelayInMSec"=dword:00000000

; 프로그램별 볼륨 설정 저장 (https://sihloh4me.tistory.com/545)
[HKEY_LOCAL_MACHINE\USER_winlite\Software\Microsoft\Internet Explorer\LowRegistry\Audio\PolicyConfig\PropertyStore]

; Shift 5번 입력 시 고정 키 팝업 비활성화
[HKEY_LOCAL_MACHINE\USER_winlite\Control Panel\Accessibility\StickyKeys]
"Flags"="506"